# ─────────────────────────────────────────────────────────────────────────────
# Potato Apparel — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never committed to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── PayPal ────────────────────────────────────────────────────────────────────
# Use 'sb' for sandbox, or your live Client ID for production
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUz...

# ── SMTP (self-hosted Poste.io mail server) ───────────────────────────────────
# Used by src/lib/mailer.ts to send inquiry notifications + customer auto-replies.
# 587 + STARTTLS is preferred; use 465 with SMTP_SECURE-equivalent (secure:true
# is derived automatically from port===465 in the code, no separate flag needed).
SMTP_HOST=mail.potatoapparel.com
SMTP_PORT=587
SMTP_USER=sales@potatoapparel.com
SMTP_PASS=
INQUIRY_TO_EMAIL=sales@potatoapparel.com

# ── Resend (legacy — no longer used by /api/inquiries, kept in case other
#    routes are added later; safe to remove if nothing references it) ─────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL=sales@yourdomain.com

# ── Prisma — admin CMS/CRM ──────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[direct-host]:5432/postgres"
# Shared secret between this app's /api/revalidate route and the admin API —
# generate any long random string, use the SAME value in both places.
REVALIDATE_SECRET=

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Get from: GA4 → Admin → Data Streams → Web stream → Measurement ID
# Format:   G-XXXXXXXXXX
# Leave blank to disable GA4 (e.g. in local dev / staging)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Search Console ─────────────────────────────────────────────────────
# Get from: Search Console → Add property → HTML tag → content="..." value only
# Example:  abcdef1234567890abcdef1234567890abcdef12
NEXT_PUBLIC_GSC_VERIFICATION=
