# ─────────────────────────────────────────────────────────────────────────────
# Potato Apparel — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never committed to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── PayPal ────────────────────────────────────────────────────────────────────
# Use 'sb' for sandbox, or your live Client ID for production
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUz...

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL=sales@yourdomain.com

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Get from: GA4 → Admin → Data Streams → Web stream → Measurement ID
# Format:   G-XXXXXXXXXX
# Leave blank to disable GA4 (e.g. in local dev / staging)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Search Console ─────────────────────────────────────────────────────
# Get from: Search Console → Add property → HTML tag → content="..." value only
# Example:  abcdef1234567890abcdef1234567890abcdef12
NEXT_PUBLIC_GSC_VERIFICATION=
