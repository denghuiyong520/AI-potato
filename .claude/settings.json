{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "netstat -ano 2>/dev/null | grep -q ':3000' || (npm run dev > /tmp/potato-dev.log 2>&1 &)",
            "async": true,
            "statusMessage": "Starting Next.js dev server on :3000..."
          }
        ]
      }
    ]
  }
}
